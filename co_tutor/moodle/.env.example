# Example .env for co_tutor/moodle
# Copy this file to .env and fill in values (DO NOT commit .env to your repo)

MOODLE_URL=https://moodle.example.org
# Option A: use a service token
MOODLE_TOKEN=

# Option B: authenticate using user credentials (the client can exchange these for a token)
MOODLE_USERNAME=
MOODLE_PASSWORD=
# Service shortname used to create tokens (commonly 'moodle_mobile_app' but depends on your Moodle)
MOODLE_SERVICE=moodle_mobile_app
